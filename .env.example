# Copy to .env.local for local development. Everything here is free except the Anthropic API.

# ── Database (local: `npm run db:dev`, then copy the TCP URL from `npx prisma dev ls`) ──
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Scratch database for `prisma migrate dev` (the local prisma dev server's shadow port).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Separate database for integration + E2E tests (`npm run db:dev:test`). Tests TRUNCATE it.
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# ── Auth (Better Auth) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
# Email + password sign-in is always on. Google and GitHub sign-in are optional extras (both free):
# Google: https://console.cloud.google.com/apis/credentials  (redirect: <BETTER_AUTH_URL>/api/auth/callback/google)
# GitHub: https://github.com/settings/developers             (redirect: <BETTER_AUTH_URL>/api/auth/callback/github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local test account used during setup: dev-tester@example.test / local-dev-pass-123
# Forgotten passwords: users reset with their recovery code (no email service). If they lost it too:
#   npm run reset-link -- someone@example.com   → prints a one-time, 1-hour reset link to send them yourself.

# ── AI (Anthropic, via the Vercel AI SDK) ──
ANTHROPIC_API_KEY=
# AI_MOCK=1                               # offline mock models (tests set this automatically)
# AI_EXTRACTION_MODEL=claude-haiku-5-5
# AI_REASONING_MODEL=claude-sonnet-5-5    # set to claude-haiku-5-5 to stretch credits
# AI_DAILY_TOKEN_LIMIT=300000             # per user, input + output tokens

# ── Job sources ──
# Always on: company careers pages (Greenhouse/Lever/Ashby public APIs, list in prisma/seed-data/career-sources.json),
# Remote OK, Arbeitnow. Check them live: `npm run scrape:check`.
# Recommended: JSearch (Google for Jobs; brings LinkedIn/Indeed listings legitimately). Free key at rapidapi.com.
# JSEARCH_API_KEY=
# ── Optional job sources ──
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_DEFAULT_COUNTRY=us
# ENABLE_REMOTIVE=false                   # keep off for multi-user: Remotive's terms forbid signup sites
