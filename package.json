{
  "name": "work_seeker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "prisma db seed",
    "db:dev": "prisma dev -d -n work-seeker",
    "db:dev:test": "prisma dev -d -n work-seeker-test",
    "vercel-build": "prisma generate && prisma migrate deploy && prisma db seed && next build",
    "scrape:check": "tsx --conditions=react-server scripts/scrape-check.mts",
    "dev:offline": "node scripts/dev-offline.mjs",
    "dev:live-jobs": "node scripts/dev-offline.mjs --live-jobs",
    "reset-link": "tsx --conditions=react-server scripts/reset-link.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/react": "^4.0.166",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/functions": "3.10.3",
    "ai": "^7.0.162",
    "better-auth": "^1.7.17",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "docx": "9.14.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
